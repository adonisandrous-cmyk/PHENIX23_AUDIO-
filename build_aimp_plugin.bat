@echo off
setlocal EnableDelayedExpansion
title AIMP Visualizer Studio - Native Plugin Compiler

echo =====================================================================
echo           AIMP Audio Visualizer Studio - Native Plugin Builder
echo =====================================================================
echo.

:: 1. Check for CMake in PATH or standard installation locations
set "CMAKE_BIN=cmake"
where cmake >nul 2>nul
if %errorlevel% neq 0 (
    if exist "C:\Program Files\CMake\bin\cmake.exe" (
        set "CMAKE_BIN=C:\Program Files\CMake\bin\cmake.exe"
    ) else if exist "C:\Program Files (x86)\CMake\bin\cmake.exe" (
        set "CMAKE_BIN=C:\Program Files (x86)\CMake\bin\cmake.exe"
    ) else if exist "%LOCALAPPDATA%\Programs\CMake\bin\cmake.exe" (
        set "CMAKE_BIN=%LOCALAPPDATA%\Programs\CMake\bin\cmake.exe"
    ) else (
        echo [ERROR] CMake was not found in PATH or standard Program Files paths.
        echo Please ensure CMake is installed and added to your PATH environment variable.
        echo Download: https://cmake.org/download/
        echo.
        pause
        exit /b 1
    )
)
echo [OK] CMake detected: %CMAKE_BIN%

:: 2. Detect Visual Studio Environment via vswhere or standard paths
set "VSWHERE_PATH=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
if exist "%VSWHERE_PATH%" (
    for /f "usebackq tokens=*" %%i in (`"%VSWHERE_PATH%" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do (
        set "VS_DIR=%%i"
    )
)

if defined VS_DIR (
    echo [OK] Visual Studio Installation Found: !VS_DIR!
    if exist "!VS_DIR!\VC\Auxiliary\Build\vcvars64.bat" (
        echo [INFO] Initializing MSVC x64 build environment...
        call "!VS_DIR!\VC\Auxiliary\Build\vcvars64.bat" >nul 2>nul
    )
)

:: 3. Prepare Source Folder Structure & Auto-Generate C++ Source if missing
echo.
echo [INFO] Preparing project directories...
if not exist "src" mkdir src

if exist "aimp_vis_studio.cpp" (
    echo [INFO] Found aimp_vis_studio.cpp, copying to src\aimp_plugin.cpp...
    copy /y "aimp_vis_studio.cpp" "src\aimp_plugin.cpp" >nul
)

if not exist "src\aimp_plugin.cpp" (
    echo [INFO] Generating native C++ plugin source file (src\aimp_plugin.cpp)...
    powershell -NoProfile -Command "@'
// ============================================================================
// AIMP Native Visual Plugin - C++ Windows Implementation
// Auto-generated by AIMP Audio Visualizer Studio
// ============================================================================

#include <windows.h>
#include <gdiplus.h>
#include <math.h>

#pragma comment(lib, \"gdiplus.lib\")
#pragma comment(lib, \"gdi32.lib\")
#pragma comment(lib, \"user32.lib\")
using namespace Gdiplus;

// --- AIMP SDK DEFINITIONS ---
#define AIMP_VISUAL_SPECTRUM_MAX 512
#define AIMP_VISUAL_WAVEFORM_MAX 512
#define AIMP_VISUAL_PLUGIN_FLAG_SPECTRUM 0x1
#define AIMP_VISUAL_PLUGIN_FLAG_WAVEFORM 0x2

#pragma pack(push, 1)
typedef struct _AIMPVisualData {
    int Width;
    int Height;
    float Spectrum[2][AIMP_VISUAL_SPECTRUM_MAX];
    float Waveform[2][AIMP_VISUAL_WAVEFORM_MAX];
    int Peak[2];
} AIMPVisualData, *PAIMPVisualData;
#pragma pack(pop)

// Pre-computed 256-color LUT in COLORREF format (0x00BBGGRR)
// Default: AIMP Amber Classic incandescent gradient
static DWORD COLOR_PALETTE_LUT[256];

static void InitPaletteLUT() {
    for (int i = 0; i < 256; i++) {
        float t = (float)i / 255.0f;
        int r, g, b;
        if (t < 0.25f) {
            float f = t / 0.25f;
            r = (int)(28 + (180 - 28) * f);
            g = (int)(14 + (83 - 14) * f);
            b = (int)(3 + (9 - 3) * f);
        } else if (t < 0.65f) {
            float f = (t - 0.25f) / 0.40f;
            r = (int)(180 + (245 - 180) * f);
            g = (int)(83 + (158 - 83) * f);
            b = (int)(9 + (11 - 9) * f);
        } else if (t < 0.90f) {
            float f = (t - 0.65f) / 0.25f;
            r = (int)(245 + (251 - 245) * f);
            g = (int)(158 + (191 - 158) * f);
            b = (int)(11 + (36 - 11) * f);
        } else {
            float f = (t - 0.90f) / 0.10f;
            r = (int)(251 + (254 - 251) * f);
            g = (int)(191 + (240 - 191) * f);
            b = (int)(36 + (138 - 36) * f);
        }
        COLOR_PALETTE_LUT[i] = RGB(r, g, b);
    }
}

// Physics and smoothing constants
static const float SMOOTHING_FACTOR = 0.82f;
static const float PEAK_GRAVITY = 1.0f * 980.0f;
static const DWORD PEAK_HOLD_MS = 400;
static const float PREAMP_GAIN = 1.2f;

struct PeakBar {
    float Height;
    float PeakValue;
    DWORD LastPeakTime;
    float Velocity;
};

static PeakBar g_Bars[64];
static ULONG_PTR g_GdiplusToken = 0;

BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved) {
    switch (fdwReason) {
        case DLL_PROCESS_ATTACH: {
            GdiplusStartupInput gdiplusStartupInput;
            GdiplusStartup(&g_GdiplusToken, &gdiplusStartupInput, NULL);
            InitPaletteLUT();
            ZeroMemory(g_Bars, sizeof(g_Bars));
            break;
        }
        case DLL_PROCESS_DETACH: {
            GdiplusShutdown(g_GdiplusToken);
            break;
        }
    }
    return TRUE;
}

extern \"C\" __declspec(dllexport) void WINAPI AIMPVisual_Render(HDC hdc, PAIMPVisualData pData) {
    if (!hdc || !pData || pData->Width <= 0 || pData->Height <= 0) return;

    int width = pData->Width;
    int height = pData->Height;
    DWORD now = GetTickCount();

    // Double-buffer bitmap for tear-free 60+ FPS rendering
    HDC memDC = CreateCompatibleDC(hdc);
    HBITMAP memBM = CreateCompatibleBitmap(hdc, width, height);
    HBITMAP oldBM = (HBITMAP)SelectObject(memDC, memBM);

    // Dark background clear
    HBRUSH bgBrush = CreateSolidBrush(RGB(10, 10, 12));
    RECT rc = { 0, 0, width, height };
    FillRect(memDC, &rc, bgBrush);
    DeleteObject(bgBrush);

    const int numBars = 64;
    const int barGap = 2;
    float barWidth = max(2.0f, (float)(width - (numBars - 1) * barGap) / (float)numBars);
    float usableH = (float)height * 0.65f;
    float baseY = usableH;

    for (int i = 0; i < numBars; i++) {
        float logPos = powf((float)i / (float)numBars, 1.6f);
        int freqIdx = (int)(logPos * (AIMP_VISUAL_SPECTRUM_MAX * 0.75f));
        if (freqIdx >= AIMP_VISUAL_SPECTRUM_MAX) freqIdx = AIMP_VISUAL_SPECTRUM_MAX - 1;

        float leftVal = pData->Spectrum[0][freqIdx];
        float rightVal = pData->Spectrum[1][freqIdx];
        float rawVal = (leftVal + rightVal) * 0.5f * PREAMP_GAIN;
        if (rawVal > 1.0f) rawVal = 1.0f;

        float targetH = rawVal * usableH;
        g_Bars[i].Height = g_Bars[i].Height + (targetH - g_Bars[i].Height) * (1.0f - SMOOTHING_FACTOR);

        float h = g_Bars[i].Height;
        float x = i * (barWidth + barGap);

        if (h >= g_Bars[i].PeakValue) {
            g_Bars[i].PeakValue = h;
            g_Bars[i].LastPeakTime = now;
            g_Bars[i].Velocity = 0.0f;
        } else {
            if (now - g_Bars[i].LastPeakTime > PEAK_HOLD_MS) {
                g_Bars[i].Velocity += PEAK_GRAVITY * 0.016f;
                g_Bars[i].PeakValue = max(0.0f, g_Bars[i].PeakValue - g_Bars[i].Velocity * 0.016f);
            }
        }

        if (h > 1.0f) {
            int lutIdx = min(255, (int)((h / usableH) * 255.0f));
            DWORD barColor = COLOR_PALETTE_LUT[lutIdx];

            HBRUSH barBrush = CreateSolidBrush(barColor);
            RECT barRc = { (LONG)x, (LONG)(baseY - h), (LONG)(x + barWidth), (LONG)baseY };
            FillRect(memDC, &barRc, barBrush);
            DeleteObject(barBrush);

            // Floor Reflection
            HBRUSH reflBrush = CreateSolidBrush(RGB(GetRValue(barColor)/4, GetGValue(barColor)/4, GetBValue(barColor)/4));
            RECT reflRc = { (LONG)x, (LONG)(baseY + 2), (LONG)(x + barWidth), (LONG)(baseY + 2 + h * 0.35f) };
            FillRect(memDC, &reflRc, reflBrush);
            DeleteObject(reflBrush);
        }

        // Floating Peak Cap
        if (g_Bars[i].PeakValue > 2.0f) {
            int peakIdx = min(255, (int)((g_Bars[i].PeakValue / usableH) * 255.0f));
            DWORD peakColor = COLOR_PALETTE_LUT[peakIdx];
            HBRUSH capBrush = CreateSolidBrush(peakColor);
            RECT capRc = { (LONG)x, (LONG)(baseY - g_Bars[i].PeakValue - 3), (LONG)(x + barWidth), (LONG)(baseY - g_Bars[i].PeakValue) };
            FillRect(memDC, &capRc, capBrush);
            DeleteObject(capBrush);
        }
    }

    BitBlt(hdc, 0, 0, width, height, memDC, 0, 0, SRCCOPY);
    SelectObject(memDC, oldBM);
    DeleteObject(memBM);
    DeleteDC(memDC);
}

extern \"C\" __declspec(dllexport) DWORD WINAPI AIMPPlugin_GetFlags() {
    return AIMP_VISUAL_PLUGIN_FLAG_SPECTRUM | AIMP_VISUAL_PLUGIN_FLAG_WAVEFORM;
}

extern \"C\" __declspec(dllexport) const WCHAR* WINAPI AIMPPlugin_GetName() {
    return L\"AIMP Visualizer Studio Plugin\";
}

extern \"C\" __declspec(dllexport) const WCHAR* WINAPI AIMPPlugin_GetAuthor() {
    return L\"AIMP Visualizer Studio\";
}
'@ | Out-File -Encoding UTF8 src\aimp_plugin.cpp"
    echo [OK] Generated src\aimp_plugin.cpp successfully.
)

if not exist "CMakeLists.txt" (
    echo [INFO] Generating CMakeLists.txt...
    (
        echo cmake_minimum_required(VERSION 3.16^)
        echo project(AimpVisualizerStudio LANGUAGES CXX^)
        echo set(CMAKE_CXX_STANDARD 17^)
        echo set(CMAKE_CXX_STANDARD_REQUIRED ON^)
        echo add_library(aimp_vis_studio SHARED src/aimp_plugin.cpp^)
        echo target_link_libraries(aimp_vis_studio PRIVATE gdiplus gdi32 user32^)
        echo set_target_properties(aimp_vis_studio PROPERTIES PREFIX "" OUTPUT_NAME "aimp_vis_studio"^)
    ) > CMakeLists.txt
    echo [OK] Generated CMakeLists.txt successfully.
)

:: 4. Run CMake Configuration
echo.
echo =====================================================================
echo [INFO] Configuring CMake Build (x64 Release)...
echo =====================================================================
"%CMAKE_BIN%" -B build -A x64
if %errorlevel% neq 0 (
    echo [WARN] 64-bit generator parameter failed, trying default generator...
    "%CMAKE_BIN%" -B build
    if %errorlevel% neq 0 (
        echo [ERROR] CMake configuration failed.
        pause
        exit /b 1
    )
)

:: 5. Compile the DLL
echo.
echo =====================================================================
echo [INFO] Compiling aimp_vis_studio.dll (Release mode)...
echo =====================================================================
"%CMAKE_BIN%" --build build --config Release --parallel
if %errorlevel% neq 0 (
    echo [ERROR] Compilation failed. Inspect MSVC/CMake logs above.
    pause
    exit /b 1
)

:: 6. Locate Built DLL Artifact
set "OUTPUT_DLL="
if exist "build\Release\aimp_vis_studio.dll" set "OUTPUT_DLL=build\Release\aimp_vis_studio.dll"
if exist "build\aimp_vis_studio.dll" set "OUTPUT_DLL=build\aimp_vis_studio.dll"
if exist "build\bin\aimp_vis_studio.dll" set "OUTPUT_DLL=build\bin\aimp_vis_studio.dll"

if not defined OUTPUT_DLL (
    echo [ERROR] Could not find compiled aimp_vis_studio.dll.
    pause
    exit /b 1
)

if not exist "dist" mkdir dist
copy /y "%OUTPUT_DLL%" "dist\aimp_vis_studio.dll" >nul

echo.
echo =====================================================================
echo [SUCCESS] Build Complete!
echo Generated Binary: dist\aimp_vis_studio.dll
echo =====================================================================
echo.

:: 7. Optional Deployment to AIMP Installation Directory
set "AIMP_DIR="
if exist "C:\Program Files\AIMP" set "AIMP_DIR=C:\Program Files\AIMP"
if exist "C:\Program Files (x86)\AIMP" set "AIMP_DIR=C:\Program Files (x86)\AIMP"

if defined AIMP_DIR (
    echo AIMP Player detected at: %AIMP_DIR%
    set /p "INSTALL_CHOICE=Do you want to install the plugin into AIMP now? (Y/N): "
    if /i "!INSTALL_CHOICE!"=="Y" (
        set "DEST_DIR=%AIMP_DIR%\Plugins\aimp_vis_studio"
        if not exist "!DEST_DIR!" mkdir "!DEST_DIR!" 2>nul
        copy /y "dist\aimp_vis_studio.dll" "!DEST_DIR!\aimp_vis_studio.dll" >nul 2>nul
        if !errorlevel! equ 0 (
            echo [OK] Successfully copied to: !DEST_DIR!\aimp_vis_studio.dll
            echo.
            echo NEXT STEPS IN AIMP:
            echo 1. Open AIMP on Windows.
            echo 2. Press Ctrl + P to open Preferences.
            echo 3. Navigate to "Plugins" -^> "Visualizations".
            echo 4. Check the box for "AIMP Visualizer Studio".
            echo 5. Start playing music and open the Visualizer window!
        ) else (
            echo [WARN] Permission denied copying to Program Files.
            echo Please re-run this script as Administrator, or manually copy:
            echo   dist\aimp_vis_studio.dll
            echo To:
            echo   !DEST_DIR!\aimp_vis_studio.dll
        )
    )
) else (
    echo AIMP default directory not found. Manually copy dist\aimp_vis_studio.dll to:
    echo   C:\Program Files\AIMP\Plugins\aimp_vis_studio\aimp_vis_studio.dll
)

echo.
pause
exit /b 0
